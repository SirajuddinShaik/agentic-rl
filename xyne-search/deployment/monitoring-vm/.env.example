XYNE_DOCKER_NETWORK=xyne-stack_xyne

PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
LOKI_PORT=3100
ALLOY_PORT=12345
CADVISOR_PORT=8082
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_WEB_PORT=9187
REDIS_EXPORTER_PORT=9121

PROMETHEUS_RETENTION=30d
PROMETHEUS_DATA_DIR=/opt/monitoring/prometheus
GRAFANA_DATA_DIR=/opt/monitoring/grafana
LOKI_DATA_DIR=/opt/monitoring/loki
ALLOY_DATA_DIR=/opt/monitoring/alloy

PROMETHEUS_USER=root
GRAFANA_USER=root
LOKI_USER=root

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

POSTGRES_EXPORTER_HOST=xyne-db
POSTGRES_EXPORTER_PORT=5432
POSTGRES_EXPORTER_DB=xyne
POSTGRES_EXPORTER_USER=xyne
POSTGRES_EXPORTER_PASSWORD=xyne

REDIS_EXPORTER_ADDR=redis://redis:6379/0

# Required by the app-sim / gpu-sim composes (no default — set a real value).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
SERVICE_ACCOUNT_ENCRYPTION_KEY=
