    {
      "type": "row",
      "title": "OCR-BBox / vLLM Runtime",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      }
    },
    {
      "type": "timeseries",
      "title": "OCR-BBox Running Requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance, node_id, model_name) (vllm:num_requests_running{job=\"ocr-vllm-direct\",instance!~\"host\\\\.docker\\\\.internal:(8000|8002)\",model_name=~\".*bbox.*|.*BBox.*|.*BBOX.*\"})",
          "legendFormat": "{{node_id}} {{instance}} {{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "OCR-BBox Queue Pressure",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 49
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance, node_id, model_name) (vllm:num_requests_waiting{job=\"ocr-vllm-direct\",instance!~\"host\\\\.docker\\\\.internal:(8000|8002)\",model_name=~\".*bbox.*|.*BBox.*|.*BBOX.*\"})",
          "legendFormat": "waiting {{node_id}} {{instance}} {{model_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by(instance, node_id, model_name) (vllm:num_requests_waiting_by_reason{job=\"ocr-vllm-direct\",reason=\"capacity\",instance!~\"host\\\\.docker\\\\.internal:(8000|8002)\",model_name=~\".*bbox.*|.*BBox.*|.*BBOX.*\"})",
          "legendFormat": "capacity waiting {{node_id}} {{instance}} {{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "OCR-BBox KV/GPU Cache",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 49
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg by(instance, node_id, model_name) (vllm:kv_cache_usage_perc{job=\"ocr-vllm-direct\",instance!~\"host\\\\.docker\\\\.internal:(8000|8002)\",model_name=~\".*bbox.*|.*BBox.*|.*BBOX.*\"} or vllm:gpu_cache_usage_perc{job=\"ocr-vllm-direct\",instance!~\"host\\\\.docker\\\\.internal:(8000|8002)\",model_name=~\".*bbox.*|.*BBox.*|.*BBOX.*\"})",
          "legendFormat": "{{node_id}} {{instance}} {{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
