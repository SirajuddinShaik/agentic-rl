# Local deployment controls. Copy to deployment/ingestion/.env.local or export
# these values before running deploy-vm.sh. Do not commit real secrets.

GCLOUD=/Users/aayush.shah/google-cloud-sdk/bin/gcloud
CLOUDSDK_PYTHON=/Users/aayush.shah/.venv/bin/python3.13
GCP_PROJECT=xyne-spaces-sbx
GCP_ZONE=asia-southeast1-a
GCP_VM=xyne-k8s-test

VM_STACK_DIR=/home/shivral_somani_juspay_in/xyne-stack
VM_DEPLOY_DIR=/home/aayush_shah_juspay_in/xyne-ingestion-deploy
VM_BACKUP_ROOT=/home/aayush_shah_juspay_in/xyne-ingestion-backups

INGESTION_IMAGE_REPO=xyne-ingestion
INGESTION_IMAGE_TAG=

# Default rollout skips xyne-app-sync because it also owns non-ingestion sync.
# Set to true only when standard file worker/app-sync code must be rolled too.
INGESTION_DEPLOY_INCLUDE_APP_SYNC=false

# Set to true to run remote docker compose config validation and backup only.
INGESTION_DRY_RUN=false

# Set to true when local Docker is unavailable; the deploy script will upload a
# filtered source tarball and build the image on the VM.
INGESTION_BUILD_ON_VM=false
