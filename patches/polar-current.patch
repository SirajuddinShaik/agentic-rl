+def _sanitize_tool_schemas(req):
+    """Neutralize cyclic tool ``parameters`` schemas (the xyne harness emits a
+    self-referential ``filters`` schema that serializes as the literal string
+    ``[REDACTED:cycle]``). SGLang's JSON-schema validator rejects that string,
+    which makes every agentic chat completion fail with "invalid 'parameters'
+    schema" before any token is generated. Replace the redacted cycle marker
+    with a permissive empty schema so the request passes through."""
+    tools = req.get("tools")
+    if not tools:
+        return req
+
+    def clean(x):
+        if isinstance(x, dict):
+            return {k: clean(v) for k, v in x.items()}
+        if isinstance(x, list):
+            return [clean(v) for v in x]
+        if x == "[REDACTED:cycle]":
+            return {}
+        return x
+
+    req["tools"] = [clean(t) for t in tools]
+    return req
