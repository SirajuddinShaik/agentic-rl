+        else:
+            if mt_i <= 0:
+                request["max_tokens"] = default
+                logger.info("inference max_tokens=%s → default %s", mt_i, default)
+            else:
+                request["max_tokens"] = mt_i
+    try:
+        capped = int(request["max_tokens"])
+    except (TypeError, ValueError, KeyError):
+        request["max_tokens"] = default
+        capped = default
+    if capped > _MAX_MAX_TOKENS:
+        logger.info("inference max_tokens=%s → hard cap %s", capped, _MAX_MAX_TOKENS)
+        request["max_tokens"] = _MAX_MAX_TOKENS
+    return request
