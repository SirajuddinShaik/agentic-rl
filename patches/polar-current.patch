+def ensure_max_tokens(request: dict[str, Any], *, default: int = _DEFAULT_MAX_TOKENS) -> dict[str, Any]:
+    """Clamp missing/null/non-positive max_tokens so inference always terminates."""
+    mt = request.get("max_tokens")
+    if mt is None or mt == "":
+        mct = request.get("max_completion_tokens")
+        if mct not in (None, "") and int(mct) > 0:
+            request["max_tokens"] = int(mct)
