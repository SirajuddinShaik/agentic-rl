+def _is_adapter_rollout_checkpoint(load: str | None) -> bool:
+    """True when --load points at a LoRA resume checkpoint (a top-level
+    ``rollout/`` dataset-state dir and/or ``iter_*`` dirs with an ``adapter/``
+    subdir) rather than a base-model checkpoint. Base weights come from
+    --hf-checkpoint via the bridge, so such a dir is a valid --load that must
+    not be treated as a fresh (no-checkpoint) run."""
+    if not load or not os.path.isdir(load):
+        return False
+    if os.path.isdir(os.path.join(load, "rollout")):
+        return True
+    try:
