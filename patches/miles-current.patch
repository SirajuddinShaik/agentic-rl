+    def _microbatch_generator(self, rollout_id):
+        """Blocking generator yielding ONE completed prompt group's raw samples.
+
+        Wraps ``miles.rollout.polar_rollout.generate_rollout_polar_async_microbatch``
+        (the streaming equivalent of ``generate_rollout_polar_async``) but yields
+        each completed group (``n_samples_per_prompt`` samples) as soon as the
+        Polar async worker drains it, instead of blocking for the full
+        ``rollout_batch_size`` batch. The trainer then ACCUMULATES groups and
+        converts/trains once a full global-batch (``GLOBAL_BATCH_SIZE`` samples,
+        i.e. ``GLOBAL_BATCH_SIZE // n_samples_per_prompt`` groups) is available --
+        so the optimizer-step topology (batch size and steps per rollout) stays
+        identical to the non-streamed path.
+
+        Runs on the calling thread (the worker does its own blocking collection);
+        driven via ``asyncio.to_thread`` so it never blocks the Ray event loop.
+        """
+        # Use the configured rollout function (can be the polar microbatch
+        # wrapper or a custom direct driver like xyne_direct_driver).
+        from miles.rollout import polar_rollout
+        microbatch_gen = polar_rollout.generate_rollout_polar_async_microbatch
+        for fn_output in microbatch_gen(
+            self.args, rollout_id, self.data_source, evaluation=False
+        ):
+            # samples = [group] (one group per yield); extract the group itself
+            group = fn_output.samples if isinstance(fn_output.samples, list) else [fn_output.samples]
+            yield list(group[0])  # one prompt group = list[Sample]
+
+    def convert_batch(self, batches):
+        """Run the post-process / convert / split pipeline on accumulated groups.
+
+        ``batches`` is a list of yielded raw groups (each ``list[Sample]``). The
+        number of groups must form whole ``global_batch_size`` units, so this is
+        called only at a train boundary. Mirrors :meth:`generate`'s conversion.
+        """
+        data = [s for g in batches for s in g]  # flatten groups -> list[Sample]
+        data, metadata = postprocess_rollout_data(
+            self.args, data, train_parallel_config=self.train_parallel_config
+        )
+        data = convert_samples_to_train_data(
+            self.args,
+            data,
+            metadata=metadata,
+            custom_convert_samples_to_train_data_func=self.custom_convert_samples_to_train_data_func,
+            custom_reward_post_process_func=self.custom_reward_post_process_func,
+        )
+        sample_indices = data.get("sample_indices")
+        if self.args.delay_split_train_data_by_dp:
+            data_ref = object_store.get_instance().put(
+                value=data, value_spec=ROLLOUT_DATA_VALUE_SPEC
+            )
+        else:
+            data_ref = split_train_data_by_dp(self.args, data, self.train_parallel_config)
+        return dict(sample_indices=sample_indices, data_ref=data_ref)
+
+    def micro_batch_size_in_groups(self):
+        """How many prompt groups make up one global-batch optimizer step."""
+        gbs = self.args.global_batch_size
+        spp = getattr(self.args, "n_samples_per_prompt", 8)
+        return max(1, gbs // spp) if spp else 1
+
+    def start_microbatch_generation(self, rollout_id):
+        """Seed the on-actor micro-batch generator for ``rollout_id``.
+
+        Ray actors cannot stream async generators back to the driver, so this
+        returns immediately and the driver advances the stream one group at a
+        time via :meth:`next_microbatch` (a plain remote call). The actual Polar
+        streaming generator runs inside this actor process.
+        """
+        self._microbatch_iter = self._microbatch_generator(rollout_id)
+        self._microbatch_rollout_id = rollout_id
+        return True
+
+    def next_microbatch(self):
+        """Return the next completed prompt group, or ``None`` when exhausted.
+
+        Blocking: waits until the Polar async worker drains the next group
+        (``n_samples_per_prompt`` samples). Returns ``(False, None)`` once the
+        rollout's groups are all consumed.
+        """
+        if self._microbatch_iter is None:
+            return (False, None)
+        try:
+            group = next(self._microbatch_iter)
+            return (True, group)
+        except StopIteration:
+            self._microbatch_iter = None
