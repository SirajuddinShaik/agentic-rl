+def _is_adapter_rollout_checkpoint(path: str | Path) -> bool:
+    """True when --load points at a LoRA resume checkpoint (a top-level ``rollout/``
+    dataset-state dir and/or ``iter_*`` dirs holding an ``adapter/`` subdir) rather
+    than a base-model checkpoint. Base weights come from --hf-checkpoint via the
+    bridge, so the base-load step must be skipped for these (see load_checkpoint)."""
+    p = Path(path)
+    if not p.is_dir():
+        return False
+    if (p / "rollout").is_dir():
+        return True
+    return any(
