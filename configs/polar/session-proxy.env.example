# Current Xyne/Polar v34 session proxy.
# Xyne's LITELLM_BASE_URL must point at this proxy, not directly at SGLang.
LITELLM_BASE_URL=http://127.0.0.1:18114
LITELLM_API_KEY=dummy-polar-gateway

POLAR_SESSION_PROXY_HOST=127.0.0.1
POLAR_SESSION_PROXY_PORT=18114
POLAR_SESSION_PROXY_UPSTREAM=http://127.0.0.1:8101
POLAR_SESSION_PROXY_TIMEOUT_SECONDS=7200
POLAR_SESSION_PROXY_DEFAULT_MAX_TOKENS=16384
POLAR_SESSION_PROXY_MAX_TOKENS=16384

POLAR_SESSION_ROUTES_PATH=/tmp/polar_session_routes.json
POLAR_SESSION_ROUTES_LOCK_PATH=/tmp/polar_session_routes.lock
POLAR_SESSION_ROUTE_TTL_SECONDS=3600
