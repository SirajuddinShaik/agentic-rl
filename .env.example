# XYNE authentication. Supply real values only in the ignored .env file.
XYNE_API_KEY=
XYNE_ACCESS_TOKEN=
XYNE_AUTH_WORKSPACE=
ACCESS_TOKEN_SECRET=
JWT_SECRET=

# Judge / Grid API
JUSPAY_API_KEY=
# The judge and policy both use the RTX2 Nemotron SGLang router.
XYNE_JUDGE_BASE_URL=http://100.64.0.149:30100/v1
XYNE_JUDGE_MODEL=nemotron
XYNE_JUDGE_MAX_TOKENS=16384
XYNE_JUDGE_MAX_CONCURRENCY=32

# Runtime locations
HF_CHECKPOINT=/data/siraj/hf_models/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
SGLANG_CHAT_TEMPLATE=/data/siraj/hf_models/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16/chat_template.jinja
PROMPT_DATA=/data/siraj/ARL/data/sebi_pranav_metadata_graph_train.jsonl
LOAD_DIR=
XYNE_BASE_URL=http://100.64.0.126:3103
XYNE_SERVER_DIR=/data/siraj/xyne_s/xyne-search-test
XYNE_RUNTIME_IMAGE=polar-xyne-runtime:base-e1c2e69e
AGENT_CLI_DIR=/data/siraj/ARL/miles/tmp/swegym_agent_cli/opt_node
POLAR_ROLLOUT_URL=http://100.64.0.126:8081
POLAR_GATEWAY_URL=http://100.64.0.126:8101
LITELLM_BASE_URL=http://100.64.0.126:18114
LITELLM_API_KEY=dummy-polar-gateway

# Optional experiment tracking
WANDB_API_KEY=
WANDB_PROJECT=xyne-rl
WANDB_MODE=online
