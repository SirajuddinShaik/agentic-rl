# XYNE authentication. Supply real values only in the ignored .env file.
XYNE_API_KEY=
XYNE_ACCESS_TOKEN=
ACCESS_TOKEN_SECRET=
JWT_SECRET=

# Judge / Grid API
JUSPAY_API_KEY=
GRID_BASE_URL=https://grid.ai.juspay.net/
XYNE_JUDGE_BASE_URL=https://grid.ai.juspay.net/
XYNE_JUDGE_MODEL=glm-latest
XYNE_JUDGE_MAX_TOKENS=4096
XYNE_JUDGE_MAX_CONCURRENCY=16

# Runtime locations
XYNE_BASE_URL=http://127.0.0.1:3001
XYNE_SERVER_DIR=/data/siraj/xyne_s/xyne-search
XYNE_RUNTIME_IMAGE=polar-xyne-runtime:withwait
AGENT_CLI_DIR=/data/siraj/ARL/miles/tmp/swegym_agent_cli/opt_node

# Optional experiment tracking
WANDB_API_KEY=
WANDB_PROJECT=xyne-rl
WANDB_MODE=online
